---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Icon from "../../../components/Icon.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { url } from "../../../lib/url";
import { dateRange } from "../../../lib/dates";

export async function getStaticPaths() {
  const editions = await getCollection("event");
  return editions.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const e = entry.data;
const slug = entry.id;
const announced = e.venue.trim().toLowerCase() !== "to be announced";
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${e.venue}, ${e.city}`,
)}`;

const crumbs = [
  { label: "Events", href: url("/events") },
  { label: e.name, href: url(`/events/${slug}`) },
  { label: "Venue" },
];
---

<Base
  title={`Venue · ${e.name}`}
  description={`Venue and location for ${e.name}.`}
>
  <section class="p-strip">
    <div class="u-container">
      <Breadcrumbs items={crumbs} />
      <h1 class="h-xl u-aubergine">Venue</h1>

      {
        announced ? (
          <>
            <p class="body u-sv3">
              Join us in {e.city.replace(/,.*$/, "")} for two days of talks,
              workshops and community. Here's how to reach the venue.
            </p>

            <div class="row u-no-padding">
              <div
                class="col-7"
                style="min-height: 360px; background: var(--u-placeholder); display: grid; place-items: center;"
              >
                {e.mapEmbed ? (
                  <iframe
                    src={e.mapEmbed}
                    title={`Map of ${e.venue}`}
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen
                    style="width: 100%; height: 100%; min-height: 360px; border: 0;"
                  />
                ) : (
                  <span class="u-text--muted">Map</span>
                )}
              </div>

              {/* Venue card; flex column so the CTA pins to the bottom. */}
              <div
                class="col-5 p-card"
                style="display: flex; flex-direction: column;"
              >
                <h2 class="p-heading--4 has-icon u-aubergine">
                  <Icon name="geo-alt-fill" class="i-accent" size={26} />{" "}
                  {e.venue}
                </h2>
                {e.venueAddress && (
                  <p class="u-text--muted">{e.venueAddress}</p>
                )}
                <p class="u-accent">{dateRange(e.startDate, e.endDate)}</p>
                <a
                  class="p-button--positive"
                  href={mapsUrl}
                  rel="noopener"
                  target="_blank"
                  style="margin-top: auto; text-align: center;"
                >
                  Get directions
                </a>
              </div>
            </div>

            {e.gettingThere.length > 0 && (
              <>
                <h2 class="h-md">Getting there</h2>
                <aside class="p-accordion">
                  {e.gettingThere.map((g, i) => (
                    <details
                      class="p-accordion__group"
                      open={i === 0}
                      style="margin-bottom: 0;"
                    >
                      <summary
                        class="p-accordion__tab"
                        style="list-style: none; padding-left: 1rem;"
                      >
                        {g.title}
                      </summary>
                      <section class="p-accordion__panel u-no-margin--bottom">
                        <p>{g.body}</p>
                      </section>
                    </details>
                  ))}
                </aside>
              </>
            )}
          </>
        ) : (
          <p class="body">
            The venue for {e.name} in {e.city} is{" "}
            <strong>to be announced</strong>. Check back soon.
          </p>
        )
      }
    </div>
  </section>
</Base>

<style>
  /* Vanilla styles .p-accordion__tab as a <button> with aria-expanded; on a
     native <details> the chevron has to be flipped from the open state.
     Pseudo-element, so this one can't be inline. */
  details:not([open]) > .p-accordion__tab::before {
    transform: rotate(-90deg);
  }
</style>
