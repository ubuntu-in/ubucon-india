---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import PeopleGrid from "../../../components/PeopleGrid.svelte";
import { getImage } from "astro:assets";
import { url } from "../../../lib/url";

const opt = async (photo) =>
  photo
    ? (await getImage({ src: photo, format: "webp", width: 520 })).src
    : undefined;

export async function getStaticPaths() {
  const editions = await getCollection("event");
  return editions.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const e = entry.data;
const slug = entry.id;

const supporters = await Promise.all(
  (await getCollection("supporters", ({ data }) => data.edition.includes(slug)))
    .map(({ id, data: s }) => ({ ...s, id }))
    .sort((a, b) => a.name.localeCompare(b.name))
    .map(async (s) => ({
      id: s.id,
      name: s.name,
      role: [s.designation, s.organisation].filter(Boolean).join(", "),
      photo: await opt(s.photo),
    })),
);

const crumbs = [
  { label: "Events", href: url("/events") },
  { label: e.name, href: url(`/events/${slug}`) },
  { label: "Supporters" },
];
---

<Base
  title={`Supporters · ${e.name}`}
  description={`Supporter pass holders of ${e.name}.`}
>
  <section class="p-strip">
    <div class="u-container">
      <Breadcrumbs items={crumbs} />
      <h1 class="h-xl u-aubergine">Supporters</h1>
      <p class="body u-sv3">
        The people who backed {e.name} with a supporter pass. Their support helps
        keep the conference accessible to everyone.
      </p>

      {
        supporters.length === 0 ? (
          <p class="body">
            Supporter pass holders for this edition will be listed here.
          </p>
        ) : (
          <PeopleGrid
            client:load
            people={supporters}
            label="Supporters"
            pageSize={100}
          />
        )
      }
    </div>
  </section>
</Base>
