---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { Image } from "astro:assets";
import { url } from "../../../lib/url";

export async function getStaticPaths() {
  const editions = await getCollection("event");
  return editions.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const e = entry.data;
const slug = entry.id;
const now = new Date();
const past = e.endDate < now;

const upcoming =
  (await getCollection("event"))
    .sort((a, b) => a.data.startDate.getTime() - b.data.startDate.getTime())
    .find((ev) => ev.data.endDate >= now) ?? null;

const TIER_META = {
  diamond: { label: "Diamond Sponsors", sub: "Lead Partners", size: "lg" },
  platinum: { label: "Platinum Sponsors", sub: "Presenting Partners", size: "lg" },
  gold: { label: "Gold Sponsors", sub: "Headline Sponsors", size: "md" },
  venue: { label: "Venue Partner", sub: "Host Venue", size: "md" },
  silver: { label: "Silver Sponsors", sub: "Supporting Sponsors", size: "sm" },
  bronze: { label: "Bronze Sponsors", sub: "Supporting Sponsors", size: "sm" },
  supporter: { label: "Supporters", sub: "Friends of UbuCon", size: "xs" },
  community: { label: "Community Partners", sub: "Partners & Media", size: "xs" },
} as const;
const ORDER = Object.keys(TIER_META) as (keyof typeof TIER_META)[];

const sponsors = await getCollection("sponsors", ({ data }) =>
  data.editions.includes(slug),
);
const groups = ORDER.map((tier) => ({
  tier,
  items: sponsors.filter((s) => s.data.tier === tier),
})).filter((g) => g.items.length > 0);

const crumbs = [
  { label: "Events", href: url("/events") },
  { label: e.name, href: url(`/events/${slug}`) },
  { label: "Sponsors" },
];
---

<Base title={`Sponsors · ${e.name}`} description={`Sponsors and partners of ${e.name}.`}>
  <!-- ─────────── Hero & Intro ─────────── -->
  <section class="p-strip is-shallow">
    <div class="u-container">
      <Breadcrumbs items={crumbs} />
      <div class="sponsors-hero">
        <span class="sponsors-hero__eyebrow">{e.name}</span>
        <h1 class="h-xl u-aubergine sponsors-hero__title">Our Sponsors & Partners</h1>
        <p class="body sponsors-hero__lede">
          {e.name} is powered by visionary organisations that support open source.
          Thank you to the partners making this conference possible.
        </p>

        {
          !past && (
            <div class="p-notification--information is-inline sponsors-hero__banner">
              <div class="p-notification__content">
                <span class="p-notification__title">Sponsorship Spots Open</span>
                &nbsp;
                <p class="p-notification__message">
                  Reach decision-makers and developers. <a href={url("/contact")}>Get in touch</a> to secure your tier.
                </p>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- ─────────── Sponsors Grid Section ─────────── -->
  <section class="p-strip">
    <div class="u-container">
      {
        groups.length === 0 ? (
          <div class="u-align--center">
            <p class="body empty">
              Sponsors for {e.name} will be announced soon. Interested in supporting the conference?
            </p>
            <a class="p-button--positive" href={url("/contact")}>Become a Sponsor</a>
          </div>
        ) : (
          <div class="tiers-wrap">
            {groups.map((g) => (
              <div class="tier-section">
                <div class="tier-header">
                  <span class="tier-sub">{TIER_META[g.tier].sub}</span>
                  <h2 class="tier-name">{TIER_META[g.tier].label}</h2>
                  <span class="tier-bar" aria-hidden="true" />
                </div>
                <div
                  class:list={[
                    "p-logo-section",
                    "sponsors-grid",
                    `logos--${TIER_META[g.tier].size}`,
                  ]}
                >
                  <div class="p-logo-section__items">
                    {g.items.map(({ data: s }) => (
                      <div class="p-logo-section__item">
                        <a
                          href={s.url}
                          rel="noopener"
                          target="_blank"
                          aria-label={s.name}
                        >
                          {s.logo ? (
                            <Image
                              class="p-logo-section__logo"
                              src={s.logo}
                              alt={s.name}
                              loading="lazy"
                            />
                          ) : (
                            <span class="logo__name">{s.name}</span>
                          )}
                        </a>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- ─────────── Why Partner With Us (Vanilla Grid Cards) ─────────── -->
  {
    !past && (
      <section class="p-strip">
        <div class="u-container">
          <div class="sponsors-benefits__head">
            <span class="eyebrow">Why Partner With Us</span>
            <h2 class="h-xl u-aubergine">Connect with the Ubuntu Community</h2>
            <p class="body sponsors-benefits__lede">
              Sponsoring UbuCon India gives your brand direct exposure to Linux professionals, open-source contributors, and engineering leaders.
            </p>
          </div>

          <div class="sponsors-benefits__grid">
            <div class="p-card--highlighted sponsor-benefit-card">
              <div class="p-card__content">
                <h3 class="u-aubergine">Brand Visibility</h3>
                <p>Position your organisation at the forefront of open source innovation across our website, stage, and event media.</p>
              </div>
            </div>

            <div class="p-card sponsor-benefit-card">
              <div class="p-card__content">
                <h3 class="u-aubergine">Talent & Recruitment</h3>
                <p>Interact directly with passionate developers, DevOps engineers, system architects, and open source talent.</p>
              </div>
            </div>

            <div class="p-card sponsor-benefit-card">
              <div class="p-card__content">
                <h3 class="u-aubergine">Community Leadership</h3>
                <p>Demonstrate your commitment to Linux ecosystem growth and support regional open source initiatives in India.</p>
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- ─────────── Call To Action Panel ─────────── -->
  <section class="p-strip is-shallow">
    <div class="u-container">
      {
        upcoming ? (
          <div class="sponsor-cta">
            <span class="sponsor-cta__eyebrow">Sponsorship Prospectus</span>
            <h2 class="sponsor-cta__title">
              Want to sponsor {upcoming.data.name}?
            </h2>
            <div class="sponsor-cta__text">
              <p>
                Reach a passionate open-source audience. Download our prospectus or contact us to secure your tier.
              </p>
            </div>
            <div class="sponsor-cta__actions">
              <a class="p-button--positive" href={url("/contact")}>
                Become a Sponsor
              </a>
              {upcoming.data.prospectusUrl && (
                <a
                  class="p-button"
                  href={upcoming.data.prospectusUrl}
                  rel="noopener"
                  target="_blank"
                >
                  Download Prospectus
                </a>
              )}
            </div>
          </div>
        ) : (
          <div class="sponsor-cta">
            <span class="sponsor-cta__eyebrow">Community Support</span>
            <h2 class="sponsor-cta__title">Support the Community</h2>
            <div class="sponsor-cta__text">
              <p>
                No edition is on the calendar yet. UbuCon India runs on
                volunteers — a donation keeps the community going between
                events.
              </p>
            </div>
            <div class="sponsor-cta__actions">
              <a class="p-button--positive" href={url("/contact")}>
                Donate to the Community
              </a>
            </div>
          </div>
        )
      }
    </div>
  </section>
</Base>




