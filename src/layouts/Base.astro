---
import "../styles/global.scss";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { url } from "../lib/url";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const siteName = "UbuCon India";
const {
  title,
  description = "The Indian community conference for Ubuntu and open source.",
  ogImage,
} = Astro.props;

const fullTitle = !title
  ? `${siteName} | Community Conference by Ubuntu India`
  : title.includes(siteName)
    ? title
    : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Edition pages get their dated share card, everything else the evergreen one.
const edition = Astro.url.pathname.match(/^\/events\/india-(\d{4})\//)?.[1];
const socialCard = ogImage ?? (edition ? `/og-${edition}.png` : "/og-evergreen.png");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(socialCard, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="google-site-verification" content="rIfbKP-K9fzW33Mb_DHIP3MfXLbAoZ7LlU3JF9lJKuc" />
    <title>{fullTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="u-off-screen">Skip to main content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
